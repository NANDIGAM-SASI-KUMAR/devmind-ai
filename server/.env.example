PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devmind
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars
SARVAM_API_KEY=sk_your-sarvam-key-here
RESEND_API_KEY=re_your-resend-key-here
RESEND_FROM_EMAIL=DevMind <onboarding@resend.dev>
SKIP_OTP_VERIFICATION=false
CLIENT_URL=http://localhost:5173
# Optional. Caches Results/progress/usage aggregations. If unset, the app falls back to an
# in-process LRU cache automatically — Redis is only needed if you're running multiple
# server instances that need to share cached data.
REDIS_URL=
# Chroma vector database. Leave all three unset for local dev — connects to a local Chroma
# server on CHROMA_HOST:CHROMA_PORT (default localhost:8000, started with `npm run chroma`).
# Set CHROMA_API_KEY (Chroma Cloud) for any deployed environment — without it, Study Plan
# material uploads, Project code search, and quiz/exam generation cannot index anything.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# Local-dev-only overrides (ignored once CHROMA_API_KEY is set):
CHROMA_HOST=
CHROMA_PORT=
# Optional. "local" (default) runs a real cross-encoder reranker in-process (~90MB model,
# ~5-10ms/candidate, no external call). Set to "llm" on a memory-constrained host to use a
# single batched Sarvam call instead (slower, ~2.3-2.7s, but no extra memory footprint).
RERANKER_PROVIDER=